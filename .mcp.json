{
  "mcpServers": {
    "SONARQUBE_PROJ": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--pull=always",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_PROJECT_KEY",
        "-e",
        "SONARQUBE_TOOLSETS",
        "-e",
        "SONARQUBE_DEBUG_ENABLED",
        "-e",
        "SONAR_LOG_LEVEL",
        "-v",
        "/Users/Tom.Howlett/repos/gctoolkit:/app/mcp-workspace:rw",
        "-v",
        "/Users/Tom.Howlett/repos/gctoolkit/mcplogs:/app/storage/logs:rw",
        "mcp/sonarqube"
      ],
      "env": {
        "SONARQUBE_URL": "https://sonarcloud.io",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "tom-howlett-sonarsource",
        "SONARQUBE_PROJECT_KEY": "tom-howlett-sonarsource_gctoolkit",
        "SONARQUBE_TOOLSETS": "analysis,cag,issues,projects,quality-gates,rules,duplications,measures,security-hotspots,dependency-risks,coverage",
        "SONARQUBE_DEBUG_ENABLED": "true",
        "SONAR_LOG_LEVEL": "DEBUG"
      }
    }
  }
}